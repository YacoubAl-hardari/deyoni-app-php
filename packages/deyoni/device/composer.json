{
    "name": "deyoni/device",
    "version": "1.0.0",
    "description": "Android document backup and Arabic UI integration for Deyoni",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.6",
        "nativephp/mobile-ui": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "Deyoni\\Device\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Deyoni\\Device\\DeyoniDeviceServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
